# Frontend environment
# Copy this file to .env when you need to override the local API URL.
VITE_API_URL=http://127.0.0.1:5050/api

# Google/Apple OAuth uses a redirect flow through the API, so the frontend
# needs no client IDs. Configure providers in server/.env (see server/.env.example)
# and on Vercel (API project env vars). Set FRONTEND_URL on the API to this
# site's origin so callbacks can redirect back to /auth/callback.
