NODE_ENV=development
PORT=5050

# MongoDB Atlas
# 1. Create a cluster at https://cloud.mongodb.com
# 2. Add a database user and allow your IP under Network Access
# 3. Replace USERNAME, PASSWORD and CLUSTER below with the values from
#    Atlas > Connect > Drivers. Keep /lindbergh_ultimate in the path.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/lindbergh_ultimate?retryWrites=true&w=majority
# Optional: overrides the database in the URI.
MONGODB_DB_NAME=lindbergh_ultimate

# Local development alternative (comment out the Atlas URI above):
# MONGODB_URI=mongodb://127.0.0.1:27017/lindbergh_ultimate

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional shared key for scripts: send as x-api-key or Authorization: Bearer <key>
ADMIN_API_KEY=local-dev-api-key

# Public site URL (frontend). Used to redirect back after Google/Apple sign-in.
# In production set this to the frontend Vercel URL.
FRONTEND_URL=http://localhost:5173
# Public API URL. Used to build OAuth callback URLs when OAUTH_CALLBACK_URL is unset.
# In production set this to the API Vercel URL (without /api suffix).
API_PUBLIC_URL=http://localhost:5050

# CORS (comma separated). Local Vite ports 5173 and 5174 are included so the
# frontend still works if 5173 is already in use. Add production origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Example: CORS_ORIGINS=https://lindberghultimatefrisbee-terry-biesboers-projects.vercel.app

# --- OAuth: Google ---
# 1. Create a project at https://console.cloud.google.com
# 2. APIs & Services > Credentials > Create Credentials > OAuth client ID (Web)
# 3. Authorized redirect URIs:
#    http://localhost:5050/api/auth/oauth/google/callback
#    https://<api-domain>/api/auth/oauth/google/callback
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: Apple Sign In (web) ---
# 1. Register an App/Services ID at https://developer.apple.com
# 2. Enable "Sign in with Apple" and set the Return URL to:
#    https://<api-domain>/api/auth/oauth/apple/callback
# 3. Create a key (.p8), copy its Key ID + Team ID, and paste the .p8 contents below
#    (or set APPLE_PRIVATE_KEY_PATH to the .p8 file path when running locally).
# 4. APPLE_CLIENT_ID is your Services ID (e.g. com.example.lindbergh.web).
# Leave blank to disable Apple sign-in.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=

# Optional override for the OAuth callback base (defaults to API_PUBLIC_URL).
# OAUTH_CALLBACK_URL=https://<api-domain>/api/auth/oauth

# Comma-separated list of emails allowed to create a staff account via OAuth.
# Existing staff users can always link Google/Apple; SEED_ADMIN_EMAIL is always
# allowed. Anyone else gets "This email is not authorized for the admin panel."
ADMIN_OAUTH_ALLOWLIST=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_MAX=30

# Logging
LOG_FORMAT=dev

# Single Admin Panel account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true to add sample players, parents and donations
SEED_DEMO_DATA=false
