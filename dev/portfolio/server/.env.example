NODE_ENV=development
PORT=5050

# MongoDB Atlas
# 1. Create a cluster at https://cloud.mongodb.com
# 2. Add a database user and allow your IP under Network Access
# 3. Replace USERNAME, PASSWORD and CLUSTER below with the values from
#    Atlas > Connect > Drivers. Keep /lindbergh_ultimate in the path.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/lindbergh_ultimate?retryWrites=true&w=majority
# Optional: overrides the database in the URI.
MONGODB_DB_NAME=lindbergh_ultimate

# Local development alternative (comment out the Atlas URI above):
# MONGODB_URI=mongodb://127.0.0.1:27017/lindbergh_ultimate

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional shared key for scripts: send as x-api-key or Authorization: Bearer <key>
ADMIN_API_KEY=local-dev-api-key

# CORS (comma separated). Local Vite ports 5173 and 5174 are included so the
# frontend still works if 5173 is already in use. Add production origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Example: CORS_ORIGINS=https://lindberghultimate.com,https://www.lindberghultimate.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_MAX=30

# Logging
LOG_FORMAT=dev

# Single Admin Panel account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true to add sample players, parents and donations
SEED_DEMO_DATA=false
